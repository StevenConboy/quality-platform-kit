# Copy to .env and adjust. All values are optional; defaults are shown.

# Which LLM provider the app uses: "fake" (offline, deterministic) or "anthropic".
TRIAGE_PROVIDER=fake

# Only needed when TRIAGE_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
TRIAGE_MODEL=claude-opus-5

# How long the app waits for the LLM before falling back.
TRIAGE_LLM_TIMEOUT_SECONDS=8

# Total tokens (input + output) the app may spend before it refuses LLM calls.
TRIAGE_TOKEN_BUDGET=200000

# Path to the fault-injection config.
TRIAGE_FAULTS_FILE=faults.json

# Extra latency added by the slow_response fault.
TRIAGE_SLOW_RESPONSE_SECONDS=3
